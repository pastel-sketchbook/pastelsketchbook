{
  "name": "pastel-sketchbook",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "bun scripts/sync-videos.ts && bun scripts/sync-repos.ts && bun scripts/generate-wiki.ts && bun scripts/semiannual-channel-analysis.ts --if-due",
    "wiki:generate": "bun scripts/generate-wiki.ts",
    "wiki:transcripts": "bun scripts/export-transcripts.ts",
    "wiki:analysis": "bun scripts/semiannual-channel-analysis.ts",
    "wiki:analysis:if-due": "bun scripts/semiannual-channel-analysis.ts --if-due",
    "build": "vite build",
    "preview": "vite preview",
    "sync:videos": "bun scripts/sync-videos.ts",
    "router:generate": "tsr generate",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:unsafe": "biome check --unsafe --write .",
    "test": "bun test",
    "test:run": "bun test",
    "test:coverage": "bun test --coverage",
    "check:all": "bun run format:check && bun run lint && bun run test:coverage",
    "deploy:vercel": "vercel --prod --yes"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@google/genai": "^2.31.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "1.170.16",
    "framer-motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-cli": "1.167.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vercel/node": "^24.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "daisyui": "^5.7.50",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vercel": "^65.5.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-generator": "1.166.42",
    "@tanstack/router-utils": "1.161.8",
    "@tootallnate/once": "^3.0.1",
    "ajv": "^8.18.0",
    "basic-ftp": "^5.3.1",
    "brace-expansion": "^1.1.13",
    "diff": "^8.0.3",
    "ip-address": "^10.1.1",
    "minimatch": "^3.1.3",
    "path-to-regexp": "^6.3.0",
    "picomatch": "^2.3.2",
    "protobufjs": "^7.5.5",
    "rollup": "^4.59.0",
    "smol-toml": "^1.6.1",
    "srvx": "^0.11.13",
    "tar": "^7.5.8",
    "undici": "^6.23.0"
  }
}
