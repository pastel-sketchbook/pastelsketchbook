{
  "name": "pastel-sketchbook",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "bun scripts/sync-videos.ts && bun scripts/sync-repos.ts && bun scripts/generate-wiki.ts && bun scripts/semiannual-channel-analysis.ts --if-due",
    "wiki:generate": "bun scripts/generate-wiki.ts",
    "wiki:transcripts": "bun scripts/export-transcripts.ts",
    "wiki:analysis": "bun scripts/semiannual-channel-analysis.ts",
    "wiki:analysis:if-due": "bun scripts/semiannual-channel-analysis.ts --if-due",
    "build": "vite build",
    "preview": "vite preview",
    "sync:videos": "bun scripts/sync-videos.ts",
    "router:generate": "tsr generate",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:all": "bun run format:check && bun run lint && bun run test:coverage",
    "deploy:vercel": "vercel --prod --yes"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@google/genai": "^1.52.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "framer-motion": "^12.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "three": "^0.184.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/router-cli": "^1.166.42",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vercel/node": "^5.7.15",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "daisyui": "^5.5.19",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "vercel": "^53.2.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
